// Skyline SIS — Prisma schema (spec section 8, "Data model").
// Conventions: camelCase fields mapped to snake_case columns; snake_case table
// names via @@map. Money is Decimal(12,2) (never float). Timestamps are
// timestamptz; the booking/consultation domain stores UTC instants explicitly.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────────────────────

enum ProgramLevel {
  BA
  MA
  MBA
  PhD
  professional
}

enum ProgramChoiceStatus {
  none
  proposed
  approved
  rejected
  confirmed
}

// Pipeline stages (spec section 9). Single state machine on the applicant.
enum ApplicantStage {
  intake_started
  consultation_booked
  consultation_completed
  program_proposed
  program_approved
  program_confirmed
  documents_pending
  documents_verified
  invoice_issued
  payment_received
  enrolled
  active_student
  graduated
  withdrawn
  rejected
}

enum ConsultationStatus {
  booked
  completed
  cancelled
  no_show
}

enum Eligibility {
  eligible
  needs_review
  not_eligible
}

enum DocumentType {
  passport
  emirates_id
  prior_diploma
  transcript
  photo
  legalization
  other
}

enum DocumentStatus {
  required
  uploaded
  verified
  rejected
}

enum InvoiceStatus {
  draft
  issued
  partially_paid
  paid
  cancelled
}

enum PaymentMethod {
  bank_transfer
  card
  cash
  other
}

// Auth: who logs into the SIS. Students see their own portal; staff (advisors/
// admins) see the admin. Teachers are NOT SIS users (Moodle only).
enum UserRole {
  student
  staff
  admin
}

// ─────────────────────────────────────────────────────────────────────────────
// Auth
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         UserRole @default(student)

  // A student user is linked to their applicant record; staff users to an advisor.
  applicantId  String?  @unique @map("applicant_id")
  applicant    Applicant? @relation(fields: [applicantId], references: [id])
  advisorId    String?  @unique @map("advisor_id")
  advisor      Advisor?   @relation(fields: [advisorId], references: [id])

  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("users")
}

// ─────────────────────────────────────────────────────────────────────────────
// Advisors & availability
// ─────────────────────────────────────────────────────────────────────────────

model Advisor {
  id     String  @id @default(uuid())
  name   String
  email  String  @unique
  active Boolean @default(true)

  // The single advisor whose availability backs the public self-booking page.
  // Public bookings land here, then staff reassign to a specific advisor.
  publicBooking Boolean @default(false) @map("public_booking")

  availabilityRules AvailabilityRule[]
  applicants        Applicant[]
  consultations     Consultation[]
  user              User?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("advisors")
}

model AvailabilityRule {
  id          String  @id @default(uuid())
  advisorId   String  @map("advisor_id")
  advisor     Advisor @relation(fields: [advisorId], references: [id], onDelete: Cascade)

  // 0=Sunday .. 6=Saturday. Times as "HH:mm" in the rule's IANA timezone.
  weekday     Int
  startTime   String  @map("start_time")
  endTime     String  @map("end_time")
  slotMinutes Int     @map("slot_minutes")
  timezone    String  // IANA name, e.g. "Asia/Dubai" (NOT a numeric offset)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([advisorId, weekday])
  @@map("availability_rules")
}

// ─────────────────────────────────────────────────────────────────────────────
// Catalog: universities → programs → courses
// ─────────────────────────────────────────────────────────────────────────────

model University {
  id        String  @id @default(uuid())
  name      String
  shortName String? @map("short_name")
  country   String  @default("RS")
  notes     String?
  // Moodle top-level category this was imported from (null = SIS-authored).
  moodleCategoryId Int? @unique @map("moodle_category_id")

  programs Program[]
  forwards Forward[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("universities")
}

model Program {
  id             String       @id @default(uuid())
  universityId   String       @map("university_id")
  university     University   @relation(fields: [universityId], references: [id])

  name           String
  level          ProgramLevel
  ects           Int?
  durationMonths Int?         @map("duration_months")
  tuitionTotal   Decimal      @map("tuition_total") @db.Decimal(12, 2)
  tuitionCurrency String      @default("AED") @map("tuition_currency")
  active         Boolean      @default(true)
  // Moodle sub-category this was imported from (null = SIS-authored).
  moodleCategoryId Int?       @unique @map("moodle_category_id")

  courses        Course[]
  terms          Term[]
  proposedBy     Applicant[]  @relation("ProposedProgram")
  chosenBy       Applicant[]  @relation("ChosenProgram")
  recommendedIn  ConsultationRecord[]
  invoices       Invoice[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([universityId])
  @@map("programs")
}

// A semester/term within a program. This is the level a student is invoiced and
// enrolled at (multi-semester / multi-year). Courses hang off a term; the term
// carries the fee. Added additively: Course.programId is retained during the
// transition, with Course.termId populated by the reworked Moodle import.
model Term {
  id              String  @id @default(uuid())
  programId       String  @map("program_id")
  program         Program @relation(fields: [programId], references: [id], onDelete: Cascade)

  name            String  // e.g. "I semestar"
  sequence        Int     @default(0) // order within the program (1, 2, 3 …)
  tuitionTotal    Decimal @default(0) @map("tuition_total") @db.Decimal(12, 2)
  tuitionCurrency String  @default("AED") @map("tuition_currency")
  active          Boolean @default(true)
  // Moodle (semester) category this term was imported from.
  moodleCategoryId Int?   @unique @map("moodle_category_id")

  courses     Course[]
  enrollments TermEnrollment[]
  invoices    Invoice[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([programId])
  @@map("terms")
}

model Course {
  id             String  @id @default(uuid())
  programId      String  @map("program_id")
  program        Program @relation(fields: [programId], references: [id], onDelete: Cascade)
  // Term the course belongs to. Nullable during the flat→term migration; the
  // reworked import sets it, then it becomes the primary grouping.
  termId         String? @map("term_id")
  term           Term?   @relation(fields: [termId], references: [id], onDelete: Cascade)

  name           String
  moodleCourseId Int?    @map("moodle_course_id")
  sequence       Int     @default(0)

  enrollments    CourseEnrollment[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([programId])
  @@index([termId])
  @@map("courses")
}

enum TermEnrollmentStatus {
  pending   // term not yet billed
  invoiced  // invoice issued for the term
  paid      // payment cleared the unlock threshold
  enrolled  // student enrolled in the term's Moodle courses
}

// Per-(applicant, term) progress: the spine of the multi-semester lifecycle.
// A student advances term by term — each term is invoiced, paid, then enrolled.
model TermEnrollment {
  id          String               @id @default(uuid())
  applicantId String               @map("applicant_id")
  applicant   Applicant            @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  termId      String               @map("term_id")
  term        Term                 @relation(fields: [termId], references: [id], onDelete: Cascade)

  status      TermEnrollmentStatus @default(pending)
  invoiceId   String?              @map("invoice_id")
  enrolledAt  DateTime?            @map("enrolled_at") @db.Timestamptz(6)

  createdAt   DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([applicantId, termId])
  @@index([termId])
  @@map("term_enrollments")
}

enum EnrollmentStatus {
  pending
  enrolled
  failed
}

// Per-(applicant, course) Moodle enrollment record so provisioning is idempotent
// and resumable: a job that dies after enrolling 3 of 5 courses re-runs and only
// completes the remaining 2. (Resolves the partial-enrollment risk from review.)
model CourseEnrollment {
  id          String           @id @default(uuid())
  applicantId String           @map("applicant_id")
  applicant   Applicant        @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  courseId    String           @map("course_id")
  course      Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)

  status      EnrollmentStatus @default(pending)
  error       String?
  enrolledAt  DateTime?        @map("enrolled_at") @db.Timestamptz(6)

  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([applicantId, courseId])
  @@map("course_enrollments")
}

// ─────────────────────────────────────────────────────────────────────────────
// Applicants — the spine of the pipeline
// ─────────────────────────────────────────────────────────────────────────────

model Applicant {
  id              String  @id @default(uuid())
  firstName       String  @map("first_name")
  lastName        String  @map("last_name")
  email           String  @unique
  phone           String?

  countryOfOrigin String? @map("country_of_origin")
  residenceCity   String? @map("residence_city")
  priorEducation  String? @map("prior_education")
  interests       String? // captured by the intake bot

  // Richer profile (admission-services context; sponsor replaces K-12 guardian).
  dateOfBirth           DateTime? @map("date_of_birth") @db.Date
  gender                String?
  addressLine           String?   @map("address_line")
  sponsorName           String?   @map("sponsor_name")
  sponsorContact        String?   @map("sponsor_contact")
  emergencyContactName  String?   @map("emergency_contact_name")
  emergencyContactPhone String?   @map("emergency_contact_phone")
  // Where the lead came from, e.g. "public_booking" for the self-service page.
  leadSource            String?   @map("lead_source")

  stage           ApplicantStage @default(intake_started)

  assignedAdvisorId String?  @map("assigned_advisor_id")
  assignedAdvisor   Advisor? @relation(fields: [assignedAdvisorId], references: [id])

  // Program selection (propose → approve → confirm). program_choice_status is the
  // source of truth; `stage` mirrors it. See spec sections 7 & 9.
  programChoiceStatus ProgramChoiceStatus @default(none) @map("program_choice_status")
  proposedProgramId   String?  @map("proposed_program_id")
  proposedProgram     Program? @relation("ProposedProgram", fields: [proposedProgramId], references: [id])
  chosenProgramId     String?  @map("chosen_program_id")
  chosenProgram       Program? @relation("ChosenProgram", fields: [chosenProgramId], references: [id])
  proposedAt          DateTime? @map("proposed_at") @db.Timestamptz(6)
  approvedAt          DateTime? @map("approved_at") @db.Timestamptz(6)
  confirmedAt         DateTime? @map("confirmed_at") @db.Timestamptz(6)
  choiceAdvisorNote   String?   @map("choice_advisor_note")

  // Scholarship/discount applied to every term invoice (0–100 %). Staff-set.
  scholarshipPercent  Decimal  @default(0) @map("scholarship_percent") @db.Decimal(5, 2)
  scholarshipNote     String?  @map("scholarship_note")

  moodleUserId    Int?    @map("moodle_user_id")

  consultations    Consultation[]
  documents        Document[]
  invoices         Invoice[]
  forwards         Forward[]
  user             User?
  stageTransitions StageTransition[]
  courseEnrollments CourseEnrollment[]
  termEnrollments   TermEnrollment[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([stage])
  @@index([assignedAdvisorId])
  @@map("applicants")
}

// Append-only audit of every stage change: who moved an applicant from where to
// where, when, and why. The spine of the pipeline gets a paper trail from day one.
model StageTransition {
  id          String         @id @default(uuid())
  applicantId String         @map("applicant_id")
  applicant   Applicant      @relation(fields: [applicantId], references: [id], onDelete: Cascade)

  fromStage   ApplicantStage? @map("from_stage")
  toStage     ApplicantStage  @map("to_stage")
  note        String?
  byUserId    String?        @map("by_user_id") // null = system/automated

  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([applicantId, createdAt])
  @@map("stage_transitions")
}

// ─────────────────────────────────────────────────────────────────────────────
// Booking & consultation
// ─────────────────────────────────────────────────────────────────────────────

model Consultation {
  id                String    @id @default(uuid())
  applicantId       String    @map("applicant_id")
  applicant         Applicant @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  advisorId         String    @map("advisor_id")
  advisor           Advisor   @relation(fields: [advisorId], references: [id])

  scheduledStartUtc DateTime  @map("scheduled_start_utc") @db.Timestamptz(6)
  scheduledEndUtc   DateTime  @map("scheduled_end_utc") @db.Timestamptz(6)
  studentTimezone   String    @map("student_timezone") // IANA name

  status            ConsultationStatus @default(booked)
  zoomJoinUrl       String?   @map("zoom_join_url")
  reminderSentAt    DateTime? @map("reminder_sent_at") @db.Timestamptz(6)

  record ConsultationRecord?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Atomic reservation is enforced by a PARTIAL unique index (added in a manual
  // migration): unique on (advisor_id, scheduled_start_utc) WHERE status IN
  // ('booked','completed'). A cancelled / no-show booking keeps its row for the
  // record but frees the slot for rebooking. Prisma can't express partial unique
  // indexes, so this is a plain index here + raw SQL in the migration.
  @@index([advisorId, scheduledStartUtc])
  @@index([applicantId])
  @@map("consultations")
}

model ConsultationRecord {
  id                   String       @id @default(uuid())
  consultationId       String       @unique @map("consultation_id")
  consultation         Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)

  goal                 String?
  priorEducationLevel  String?      @map("prior_education_level")
  priorEducationField  String?      @map("prior_education_field")
  yearsExperience      Int?         @map("years_experience")
  fitProgramArea       String?      @map("fit_program_area")
  eligibility          Eligibility?
  recommendedProgramId String?      @map("recommended_program_id")
  recommendedProgram   Program?     @relation(fields: [recommendedProgramId], references: [id])
  recommendedLevel     String?      @map("recommended_level")
  notes                String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("consultation_records")
}

// ─────────────────────────────────────────────────────────────────────────────
// Documents (collected AFTER the consultation; stored outside web root)
// ─────────────────────────────────────────────────────────────────────────────

model Document {
  id          String         @id @default(uuid())
  applicantId String         @map("applicant_id")
  applicant   Applicant      @relation(fields: [applicantId], references: [id], onDelete: Cascade)

  type        DocumentType
  status      DocumentStatus @default(required)
  filePath    String?        @map("file_path") // path within STORAGE_DIR, never public
  notes       String?
  // Soft-delete: archived, not erased — file is retained for recovery.
  deletedAt   DateTime?      @map("deleted_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([applicantId])
  @@map("documents")
}

// ─────────────────────────────────────────────────────────────────────────────
// Finance: invoices, payments (money IN), forwards (money OUT)
// ─────────────────────────────────────────────────────────────────────────────

model Invoice {
  id          String        @id @default(uuid())
  applicantId String        @map("applicant_id")
  applicant   Applicant     @relation(fields: [applicantId], references: [id])
  programId   String        @map("program_id")
  program     Program       @relation(fields: [programId], references: [id])
  // The term this invoice bills for (per-semester billing). Nullable during the
  // flat→term migration; per-term invoicing sets it.
  termId      String?       @map("term_id")
  term        Term?         @relation(fields: [termId], references: [id])

  amountTotal Decimal       @map("amount_total") @db.Decimal(12, 2)
  currency    String        @default("AED")
  status      InvoiceStatus @default(draft)
  issuedAt    DateTime?     @map("issued_at") @db.Timestamptz(6)
  dueAt       DateTime?     @map("due_at") @db.Timestamptz(6)

  payments Payment[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([applicantId])
  @@map("invoices")
}

model Payment {
  id         String        @id @default(uuid())
  invoiceId  String        @map("invoice_id")
  invoice    Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  amount     Decimal       @db.Decimal(12, 2)
  method     PaymentMethod
  receivedAt DateTime      @default(now()) @map("received_at") @db.Timestamptz(6)
  reference  String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([invoiceId])
  @@map("payments")
}

model Forward {
  id           String     @id @default(uuid())
  universityId String     @map("university_id")
  university   University @relation(fields: [universityId], references: [id])
  applicantId  String     @map("applicant_id")
  applicant    Applicant  @relation(fields: [applicantId], references: [id])

  amount       Decimal    @db.Decimal(12, 2)
  currency     String     @default("RSD") // may differ from the invoice (e.g. RSD/EUR)
  forwardedAt  DateTime   @default(now()) @map("forwarded_at") @db.Timestamptz(6)
  reference    String?
  notes        String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([universityId])
  @@index([applicantId])
  @@map("forwards")
}

// Editable Admissions FAQ — the ONLY freeform knowledge the public questionnaire
// bot may answer from (plus catalog facts). Staff manage these in the app.
model KnowledgeEntry {
  id        String   @id @default(uuid())
  question  String
  answer    String
  category  String?
  active    Boolean  @default(true)
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("knowledge_entries")
}

// Immutable audit trail of writes to records-bearing entities (who/what/when/
// old→new). Written automatically by a Prisma write-hook; never edited.
model AuditLog {
  id          String   @id @default(uuid())
  entity      String
  entityId    String?  @map("entity_id")
  action      String   // create | update | delete
  actorUserId String?  @map("actor_user_id")
  before      Json?
  after       Json?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([entity, entityId, createdAt])
  @@index([createdAt])
  @@map("audit_logs")
}

# ── Database (native Postgres on this server) ──────────────────────────────
DATABASE_URL="postgresql://skyline:skyline_dev_pw@127.0.0.1:5432/skyline_sis?schema=public"

# ── API ────────────────────────────────────────────────────────────────────
API_PORT=3001
# The API is mounted under /api (nginx proxies https://sis.skyline-as.ae/api → :3001)
# CORS: where the Next.js web app is served from
WEB_ORIGIN="https://sis.skyline-as.ae"
# In local dev, also allow localhost (comma-separated)
WEB_ORIGIN_DEV="http://localhost:3000"

# ── Public URLs (the deployed domain) ──────────────────────────────────────
PUBLIC_BASE_URL="https://sis.skyline-as.ae"
WEB_PORT=3000

# ── Auth (Passport JWT) ────────────────────────────────────────────────────
# Generate a strong secret for real deployments: `openssl rand -base64 48`
JWT_SECRET="dev-only-change-me"
JWT_EXPIRES_IN="1d"

# Initial admin user created by the seed (change the password after first login)
ADMIN_EMAIL="admin@skyline-as.ae"
ADMIN_PASSWORD="ChangeMe!2026"

# ── Jobs (pg-boss runs inside Postgres — no Redis needed) ───────────────────
# pg-boss reuses DATABASE_URL by default; override schema if you want isolation
PGBOSS_SCHEMA="pgboss"

# ── Integrations ───────────────────────────────────────────────────────────
# AI intake (Anthropic). Until set, /api/intake returns 503.
ANTHROPIC_API_KEY=""
INTAKE_MODEL="claude-sonnet-4-6"

# Zoom Server-to-Server OAuth. Until all three are set, bookings use the
# pasted standing link below.
ZOOM_ACCOUNT_ID=""
ZOOM_CLIENT_ID=""
ZOOM_CLIENT_SECRET=""
ZOOM_FALLBACK_LINK=""

MOODLE_BASE_URL=""
MOODLE_WS_TOKEN=""
EMAIL_API_KEY=""

# ── Booking reminders ──────────────────────────────────────────────────────
REMINDER_LEAD_HOURS="24"      # remind when a call is within this many hours
REMINDER_SCAN_CRON="*/5 * * * *"

# ── File storage (v1: local dir OUTSIDE the public web root) ────────────────
STORAGE_DIR="/opt/projects/gibbon/storage"
